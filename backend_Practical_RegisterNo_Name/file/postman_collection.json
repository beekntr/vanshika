    {
      "name": "Task 1 – Library Book API",
      "item": [
        {
          "name": "1. Add Book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json(); if (b.data && b.data._id) pm.collectionVariables.set('book_id', b.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": 650,\n  \"category\": \"Software Engineering\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{library_url}}/books",
              "host": [
                "{{library_url}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
